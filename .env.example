# Environment Configuration Example
# Copy this file to .env.production and update the values

# API Configuration
VITE_API_URL=https://api.example.com
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=Atech Infotech
VITE_ENVIRONMENT=production

